{
  "manifest_version": 3,
  "name": "GEV Arlo Feed Relay",
  "version": "1.0.0",
  "description": "Sends the newest clip picture per camera from your open, signed-in my.arlo.com feed to Gods Eye View on this computer.",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://my.arlo.com/*"],
      "js": ["relay-logic.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_page": "options.html",
  "permissions": [],
  "host_permissions": [
    "https://arlos3-prod-z1.s3.amazonaws.com/*",
    "https://arlos3-prod-z2.s3.amazonaws.com/*",
    "https://arlos3-prod-z3.s3.amazonaws.com/*",
    "https://arlos3-prod-z4.s3.amazonaws.com/*",
    "http://localhost:4173/*",
    "http://127.0.0.1:4173/*"
  ]
}
