node_modules
dist
# Credential files. `.env` alone is not enough: Vite's loadEnv (see
# server/standalone/vite.config.js) and scripts/setup-doctor.mjs both read the
# full dotenv ladder — .env, .env.local, .env.<mode> and .env.<mode>.local —
# so a key placed in any of them is live for the app. Only .env was ignored,
# leaving the other three committable. .env.example is the tracked template.
.env
.env.*
!.env.example
*.log
screenshots/
qa-shots/
output/
.gev-logs/
.gev-cache/
# Browser QA gate evidence (screenshots, console and network dumps).
qa-artifacts/
.DS_Store
.gstack/
3d-models/
pinokio/ENVIRONMENT
pinokio/.installed

# Private home/business security cameras: logins and camera addresses
# (POWER UP → SECURITY CAMERAS). Never committed.
config/private-cameras.json
config/device-feeds.json
config/ultra-help.json
config/ultra-help.json.*.tmp
config/.ultra-help.json.*.tmp
config/ultra-tokens.json
config/.ultra-tokens.json.*.tmp
config/ultra-tokens.key
config/.ultra-tokens.key.*.tmp
config/ultra-inbox.json
config/.ultra-inbox.json.*.tmp
config/ultra-network.json
config/.ultra-network.json.*.tmp
config/ultra-outbound.json
config/.ultra-outbound.json.*.tmp
config/local-integrity.json
config/.local-integrity.json.*.tmp
config/local-integrity.key
config/.local-integrity.key.*.tmp
config/social-accounts.json
config/road-cctv-keys.json
config/.social-accounts.json.*.tmp
config/social-accounts.key
config/.social-accounts.key.*.tmp
config/device-recordings/
config/.device-feeds.json.*.tmp
config/.private-cameras.json.*.tmp

# Raw camera-pack downloads (tools/camera-pack/CAMERA_PACK.md): only the parsed
# cams-*.json packs are committed; the raw pages and feeds are rebuilt on demand.
tools/camera-pack/sources/*.html
tools/camera-pack/sources/*.csv
tools/camera-pack/sources/*.tsv
tools/camera-pack/sources/*.geojson
tools/camera-pack/sources/511on.json
tools/camera-pack/sources/511on-cameras.json
tools/camera-pack/sources/alberta511-cameras.json
tools/camera-pack/sources/drivebc-webcams.json

# Your own camera site for the Private_CCTV_Feed relay (never committed).
config/private_cctv_feed.local.json
config/ultra-media/
