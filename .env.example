# Local development uses one file for browser and server keys.
# Copy to .env (ignored); this example contains names and placeholders only.
# Only explicitly selected browser keys are injected into the client bundle.
# God's Eye View — environment variables
# Copy to .env and fill in your keys. On macOS the launcher can also read keys
# from the Keychain (see README); on Linux/Windows use this file or env vars.
#
# Easiest path: don't edit anything. Run the app and paste keys into the
# in-app Provider Settings panel (the POWER UP chip, bottom-right) — it writes
# this checkout's .env for you (owner-only permissions) and restarts the dev
# server. Under the Pinokio launcher it writes pinokio/ENVIRONMENT instead.
# Keys you supply yourself (shell env, Keychain) are shown as configured
# externally and never touched. This file remains the reference for headless
# and self-hosted setups.
# A key saved from POWER UP is checked. A later hand edit of that key, or of
# the address it is sent to, is not used until you save it again from POWER UP.
#
# NOTE ON CLIENT-EXPOSED KEYS: GOOGLE_MAPS_API_KEY and CESIUM_ION_TOKEN are
# injected into the browser bundle by design (they're used client-side) and
# WILL be visible in devtools. Restrict/scope them rather than trying to hide
# them (see SECURITY.md). All other keys below stay server-side.

# Optional: direct Google Photorealistic 3D Tiles and GEV place search.
# Without it, a Cesium ion token can still load ion-hosted Google 3D; with
# neither credential, the app starts on keyless Esri World Imagery with OSM
# available in the map tray and as the automatic provider-failure fallback.
# CLIENT-EXPOSED — restrict it (HTTP referrer + API restriction) in Google Cloud.
GOOGLE_MAPS_API_KEY=

# Optional: a SEPARATE Google API key for the SERVER-SIDE Google calls — Places
# (/api/google/nearby-places, /api/google/text-search) and the CCTV Street View
# fallback (#33). It never reaches the browser, so it can be restricted by
# server IP (not HTTP referrer) and scoped to just Places API + Street View
# Static API, letting the client-exposed key above stay narrowly scoped to Map
# Tiles + Geocoding. Unset, these calls fall back to GOOGLE_MAPS_API_KEY, so a
# single shared key keeps working — splitting is opt-in.
# SERVER-SIDE ONLY.
GOOGLE_MAPS_SERVER_API_KEY=
# Per-IP rate limit for the Google Places cost endpoints
# (/api/google/nearby-places + /api/google/text-search), in requests per minute.
# DEFAULTS TO 120, the value the Pinokio build already ships. Raise or lower it
# with a positive integer; 60 is a sensible tightening whenever HOST is not
# localhost. Set it to exactly 0 to run unthrottled. An unreadable value (a
# typo, a stray unit) falls back to the default rather than to unlimited, so a
# slip cannot quietly disarm the guard. A positive value below 1 counts as 1.
# NOTE: this is a per-IP, process-local guard (in-memory, resets on restart;
# over-limit requests get a sanitized 429) — it is NOT a billing cap. For hard
# spend protection set provider-side budget alerts: Google Cloud Console ->
# Billing -> Budgets & alerts (plus per-API quotas under APIs & Services ->
# Quotas).
# GEV_RATELIMIT_GOOGLE_PER_MIN=60   # uncomment to tighten from the default 120

# Optional: Google Photorealistic 3D Tiles through Cesium ion, Bing world
# imagery, and Cesium World Terrain. The free Community plan is for eligible
# personal/non-commercial use and has quotas; check current Cesium terms. A
# direct Google key above is still required for GEV place search.
# CLIENT-EXPOSED — use a public assets:read token with URL restrictions.
CESIUM_ION_TOKEN=

# Optional: OpenAI Realtime voice control. Do not prefix with VITE_.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2
# Cheaper voice tier, used when the GEV MIC panel's MINI toggle is on.
# Model ids and prices are external facts that drift — if OpenAI moves this id,
# override it here rather than editing src/voice/voiceCost.js.
OPENAI_REALTIME_MODEL_MINI=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_REASONING_EFFORT=low
# Keep only a short conversational window. Current map state is fetched live.
OPENAI_REALTIME_CONTEXT_TOKENS=3000
OPENAI_REALTIME_CONTEXT_RETENTION=0.5
OPENAI_HUD_SUMMARY_MODEL=gpt-5-nano
# Social Media Analysis → OPENAI BOT SWARM: seven web-search requests per
# press on its own key, never OPENAI_API_KEY (POWER UP → OPENAI DOTS),
# billed per search and token. Default gpt-6-astra, the model OpenAI's dots
# run on. Without the key the swarm says so and sends nothing.
# OPENAI_DOTS_API_KEY=
# OPENAI_SWARM_MODEL=gpt-6-astra
# Per-IP rate limit for the OpenAI cost endpoints
# (/api/realtime/token + /api/openai/hud-summary), in requests per minute.
# DEFAULTS TO 30, the value the Pinokio build also ships. That clears ordinary
# use several times over: an open tab asks for a HUD summary every 15s (4/min)
# and a voice session mints one token. Raise or lower it with a positive
# integer; set it to exactly 0 to run unthrottled. An unreadable value (a typo,
# a stray unit) falls back to the default rather than to unlimited, so a slip
# cannot quietly disarm the guard. A positive value below 1 counts as 1.
# NOTE: this is a per-IP, process-local guard (in-memory, resets on restart;
# over-limit requests get a sanitized 429) — it is NOT a billing cap. For hard
# spend protection set a provider-side budget: OpenAI platform -> Settings ->
# Limits (usage limits).
# GEV_RATELIMIT_OPENAI_PER_MIN=30   # the default; uncomment only to change it

# Optional: OpenSky auth mode (oauth | basic | auto | anon)
# Default: oauth — requires client credentials below
# Set to "anon" to skip aircraft auth (rate-limited but works)
# Saving OpenSky from POWER UP checks this mode with the key. A later hand
# edit is not used after the next start until you save OpenSky again.
OPENSKY_AUTH_MODE=oauth

# Optional: OpenSky OAuth credentials (from opensky-network.org account dashboard)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Optional: higher Launch Library 2 request allowance. Public access works
# without a token.
LL2_API_TOKEN=

# Optional: OpenSky credentials JSON file path (alternative to above)
# OPENSKY_CREDENTIALS_FILE=/path/to/credentials.json

# Optional: dev server config
PORT=4173
# Network binding. Default is localhost — the server is reachable ONLY from
# this machine. This is the safe default: the dev server brokers your
# configured API keys, so anyone who can reach it can spend your quota.
# LAN opt-in: set HOST=0.0.0.0 to share on your local network. WARNING: that
# exposes every key-brokering proxy to everyone on the network — use only on
# networks you trust, and consider the GEV_RATELIMIT_* throttles above.
# HOST=localhost
# HOST=0.0.0.0
# Optional: comma-separated LAN hostnames to accept, in addition to localhost
# and IP addresses, for example GEV_ALLOWED_HOSTS=globe.lan,globe.internal.
# Binding HOST=0.0.0.0 alone does NOT trust every Host header; suffix and
# wildcard entries are ignored.
# GEV_ALLOWED_HOSTS=

# Optional: the same dashboard on this machine's Tailscale address, for your
# own phone or tablet (http://<tailnet IP>:4173). It listens on the tailnet
# address only, never a LAN or public one; settings stay editable from this PC
# only. For voice, location and camera, list that address in the phone's
# chrome://flags "Insecure origins treated as secure".
# GEV_TAILNET_DASHBOARD=1

# Optional: NASA FIRMS live active fires. SERVER-SIDE ONLY (never reaches the
# browser — the client polls the /api/firms proxy). Free key:
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Without a key the FIRMS Active Fires layer is empty ("KEY REQUIRED").
# FIRMS_MAP_KEY=

# Optional: Live AIS vessels layer
# Browser fetch path. Keep same-origin so the private stream key stays server-side.
VITE_AIS_LIVE_API_URL=/api/vessels
# Client render cap. The server can keep a larger AISStream cache, but drawing
# every global vessel at once can overwhelm WebGL on laptops.
VITE_AIS_LIVE_MAX_ROWS=12000
# Active label cap after screen-space clustering. Labels exist for all rendered
# ships, but only clustered winners are shown to keep text readable.
VITE_AIS_LIVE_LABEL_MAX_ROWS=900
# Private AISStream key for the server-side websocket. Do not prefix with VITE_.
AISSTREAM_API_KEY=
# Optional AISStream subscription filters.
# AISSTREAM_BOUNDING_BOXES=[[[-90,-180],[90,180]]]
# AISSTREAM_MESSAGE_TYPES=PositionReport,StandardClassBPositionReport,ExtendedClassBPositionReport,ShipStaticData,StaticDataReport
# Feed watchdog: silence (ms) after which the feed is REPORTED stale; the socket
# is recycled at 2.5x that. Default 120000. The watchdog self-arms only for the
# default worldwide subscription — a narrow filter above can be legitimately
# quiet, so set this explicitly (sized for your filter) to opt back in.
# 0 disables the silence watch entirely.
# AISSTREAM_SILENCE_TIMEOUT_MS=120000

# Optional: local ADS-B decoder feeds for the Local ADS-B layer. SERVER-SIDE
# ONLY. Comma-separated band=url entries; band is 1090 or 978 (UAT). Each host
# must be loopback, a private (RFC1918) address, localhost or a *.local name;
# the path must end in aircraft.json. Invalid entries are logged and skipped.
# See docs/LOCAL-RECEIVERS.md.
# LOCAL_RECEIVER_FEEDS=1090=http://localhost:8080/data/aircraft.json,978=http://localhost:8978/data/aircraft.json

# Optional: TomTom live traffic flow (BYOK freemium — the free tier is 200,000
# Traffic Flow & Incidents tile requests per MONTH, not per day; no credit card
# required. Get a key at https://my.tomtom.com/keys). SERVER-SIDE ONLY:
# the browser fetches same-origin /api/tomtom/* and never sees the key.
# Keyless fallback: the traffic layer runs its built-in simulation (white dots,
# hardcoded per-road-class speeds) — no key required for the layer to work.
# TOMTOM_API_KEY=
# Optional soft cap on upstream tile fetches per UTC day (default 6000) — a
# configurable application safety ceiling, not a guarantee of staying within
# TomTom's free allowance (currently 200K tile requests/month:
# https://docs.tomtom.com/pricing/). 6000/day keeps a 31-day month at 186K,
# inside that allowance. Over the cap the proxy serves cached/stale tiles
# instead of hitting upstream.
# TOMTOM_DAILY_TILE_BUDGET=6000

# Optional: CCTV layer tuning (advanced). Defaults are sensible — leave unset
# unless you're customizing the camera source packs.
#
# Area loading: the server stores every camera in the packs but serves at most
# 1,000 — the nearest ones within 50 km of the place you select. Picking a place
# outside the loaded area swaps the cameras, even within one state. The cap and
# radius are fixed; there is no setting that raises them and no per-pack cap.
#
# Three packs ship: Canada (4,767 cameras), the US (48,697) and international
# (103,573 after dedupe; the exact count is in
# tools/camera-pack/cctv_sources.intl.report.txt). A listed file that does not
# exist is skipped.
# CCTV_SOURCES_FILE=config/cctv_sources.canada.json,config/cctv_sources.us.json,config/cctv_sources.intl.json,config/cctv_sources.inventory.json   # comma list of source-pack JSON files (this is the default)
# CCTV_SOURCES_JSON=                                   # inline source-pack JSON (overrides the files)
# CCTV_ROAD_MATCH_HOSTS=                             # hosts whose map thumbnails are matched to their road automatically: placed on it, drawn as wide, turned along it (default none; * = every camera). By default thumbnails are upright and you align them by hand: right-click a thumbnail
# CCTV_BROWSER_DIRECT_HOSTS=                          # last resort: hosts whose camera stills the viewer's browser loads itself (default none). Such cameras show in the panel and as map thumbnails, but not on the 3D monitor plane
# CCTV_AUTO_CALIBRATE=1                                # auto-calibrate camera projection (client flag)
# CCTV_DRAPE_MESH=1                                    # drape frames onto 3D geometry (client flag)
#
# Live packs (keyless) download their camera list only when a selected area
# overlaps their coverage, then keep it in memory and on disk for 24 h. They
# have no special defaults and no caps.
#   Austin open data — on when CCTV_COUNTRIES enables US.
# CCTV_AUSTIN_ROWS_URL=                                # override the Austin Open Data catalog URL
#   Caltrans — off unless you name districts (no default).
# CCTV_CALTRANS_DISTRICTS=                             # e.g. 4,7,11,3 (SF, LA, San Diego, Sacramento)
#   TfL London JamCams — on when CCTV_COUNTRIES enables GB.
# CCTV_TFL_ENABLED=1                                   # 0 turns the TfL pack off
#   Other live packs and per-pack settings (from the original project):
#   (in the original project CCTV_CALTRANS_DISTRICTS defaults to 4,7,11,3 and an empty string disables Caltrans)
# CCTV_AUSTIN_MAX_SOURCES=250                          # cap cameras loaded from the Austin catalog
# CCTV_CALTRANS_MAX_SOURCES=300                        # cap cameras loaded from Caltrans
# CCTV_TFL_MAX_SOURCES=250                             # cap cameras loaded from TfL
# CCTV_ONTARIO_ENABLED=1                               # set 0 to disable Ontario 511 cameras
# CCTV_ONTARIO_MAX_SOURCES=1000                        # cap cameras loaded from Ontario 511
# CCTV_FINTRAFFIC_ENABLED=1                            # set 0 to drop the Fintraffic (Finland) pack
# CCTV_FINTRAFFIC_MAX_SOURCES=300                      # cap cameras loaded from the Fintraffic catalog
# CCTV_DRIVEBC_MAX_SOURCES=250                         # cap DriveBC (British Columbia) cameras, nearest Vancouver/Victoria first
# CCTV_DRIVEBC_ENABLED=1                               # 0 turns off the DriveBC camera pack
# CCTV_TXDOT_ENABLED=1                                 # set 0 to disable the TxDOT (Texas) pack
# CCTV_TXDOT_DISTRICTS=AUS,SAT                         # TxDOT district codes (25 exist); empty disables the pack
# CCTV_TXDOT_MAX_SOURCES=500                           # cap cameras loaded from the TxDOT catalogs
# CCTV_TALLINN_ENABLED=1                               # set 0 to disable the Tallinn (Estonia) intersection cameras
# CCTV_TALLINN_MAX_SOURCES=255                         # cap cameras loaded from the Tallinn catalog
# CCTV_TARKTEE_ENABLED=1                               # set 0 to disable the Tarktee (Estonia) road-weather cameras
# CCTV_TARKTEE_MAX_SOURCES=179                         # cap cameras loaded from Tarktee
# CCTV_WARENDORF_ENABLED=1                             # set 0 to disable the Warendorf (Germany) municipal webcams
# CCTV_NSW_ENABLED=1                                   # set 0 to disable the Live Traffic NSW (Australia) cameras
# CCTV_NSW_MAX_SOURCES=250                             # cap cameras loaded from Live Traffic NSW
# CCTV_CALGARY_ENABLED=1                               # set 0 to disable the Open Calgary (Alberta) cameras
# CCTV_CALGARY_MAX_SOURCES=220                         # cap cameras loaded from the Open Calgary catalog
# CCTV_CALGARY_ROWS_URL=                               # override the Open Calgary catalog URL
# CCTV_VEGVESEN_ENABLED=1                              # set 0 to disable the Statens vegvesen (Norway) road cameras (downloads only when the selected area is in Norway)
# CCTV_VEGVESEN_VIDEO=1                                # set 0 to show stills instead of live HLS for Statens vegvesen video cameras
# CCTV_VEGVESEN_URL=                                   # override the Statens vegvesen catalog URL
# CCTV_MAX_SOURCES=4000                                # catalog-wide ceiling, shared round-robin across packs
# CCTV_PREFER_AUSTIN=1                                 # prioritize Austin cameras in the registry
# CCTV_FORCE_AUSTIN=                                   # force live default sources when a source-pack JSON is configured
#
# Street View stand-in: off by default. When on, it is used only for the camera
# you have open, never for map cards, and it spends the server Google key.
# CCTV_STREETVIEW_FALLBACK=0                           # 1 turns it on
#
# IBI 511 camera hosts (still URLs containing /map/Cctv/) allow 20 requests a
# minute and 1,000 a day per host. The server enforces both: the open camera
# refreshes about once a minute, map cards about every 15 minutes, and when a
# host's budget is spent the last good still (up to 60 min old) or a
# "511 LIMIT REACHED" placeholder is shown instead.

# ---------------------------------------------------------------------------
# Sea Surface Temperature (SST) layer. Map tiles come from NASA GIBS and need
# no key. EARTHDATA_TOKEN is a NASA Earthdata Login token, generated at
# https://urs.earthdata.nasa.gov/profile; the server uses it to reach
# OceanColor's MODIS Aqua Level-3 files. Tokens expire after 60 days.
# ---------------------------------------------------------------------------
# EARTHDATA_TOKEN=

# ---------------------------------------------------------------------------
# Road511: images for US traffic cameras that have no public still. SERVER-SIDE
# ONLY — the browser never sees the key. Get one at https://road511.com.
# Nothing is looked up until you open (select) such a camera; map cards,
# auto-hop and startup never call Road511. Each answer, including "no image",
# is cached in memory and on disk for 24 h, and calls are spaced at least 1 s
# apart (the free trial allows 60 a minute and 1,000 a day). Without a key those
# cameras show "Needs ROAD511_API_KEY". A POWER UP save applies it immediately.
# ---------------------------------------------------------------------------
# ROAD511_API_KEY=

# ---------------------------------------------------------------------------
# Your devices that report in (POWER UP → YOUR DEVICES → "Reports to this app").
# A phone's tracking app (Traccar Client, OwnTracks, GPSLogger, Overland) sends
# positions to a small listener the dev server opens only while such a device
# is saved. It serves that one route and nothing else, and admits a report by
# the device's key alone. The port is the app's with a 4 in front; change it if
# something else holds it. The listener answers on every interface
# so a phone on your network or VPN can reach it: never forward it on a router.
# ---------------------------------------------------------------------------
# DEVICE_REPORT_PORT=44173
# DEVICE_REPORT_HOST=0.0.0.0
# Windows Firewall: an inbound rule for this port is needed, and the Public
# profile (which a Tailscale adapter falls under) blocks node.exe by default.
# In an Administrator PowerShell:
#   New-NetFirewallRule -DisplayName "Phone reports in" -Direction Inbound -Protocol TCP -LocalPort 44173 -RemoteAddress 100.64.0.0/10,192.168.0.0/16,10.0.0.0/8 -Action Allow
#
# HTTPS for the listener. A phone's browser opens its camera only on a secure
# address, so the Ultra camera page needs https. With Tailscale: enable HTTPS
# in the tailnet's DNS settings, run `tailscale cert <machine>.<tailnet>.ts.net`
# in this folder, and point these at the two files it writes. The card then
# shows https://<that name>:44173 first.
# DEVICE_REPORT_TLS_CERT=
# DEVICE_REPORT_TLS_KEY=
# DEVICE_REPORT_PUBLIC_HOST=
#
# Simplest with Tailscale, no firewall rule and no certificate files: let
# Tailscale's own process take the connection and hand it to the listener.
# Once, in a terminal on this machine (enable HTTPS certificates in the
# tailnet's DNS settings first; the command says so if it is off):
#   tailscale serve --bg --https=443 http://127.0.0.1:44173
# The phone then reaches the listener at https://<machine>.<tailnet>.ts.net
# (port 443, real certificate, camera page allowed). Put that address here and
# the card shows it first.
# DEVICE_REPORT_PUBLIC_BASE=https://<machine>.<tailnet>.ts.net
# Saving a device checks the public address, the public name, and the
# certificate paths above. A later hand edit is not used after the next start
# until you save a device again. The port and the interface are not checked.
#
# Share help links (Ultra box → SHARE HELP TOKENS, /ultra/help/<token>) are
# built from the same listener addresses: a token with Network on (the link a
# holder's own GEVC polls at /ultra/help/<token>/network) and PUBLISH MY TOKEN
# use the first https *.ts.net address, else a plain-http 100.64.0.0/10 one —
# never a LAN address, which no other GEVC will poll — and PUBLISH refuses
# when there is none; any other token uses this base when set, otherwise the
# first address on the card. There is no variable for them and nothing to
# restart beyond the usual dev-server restart for provider code.

# ---------------------------------------------------------------------------
# HELP NETWORK (Ultra box → HELP NETWORK). The directory is one JSON file your
# group shares, at an https address, shaped
#   { "version": 1, "entries": [ { "name": "Jeff (Van 7)", "link": "https://<machine>.<tailnet>.ts.net/ultra/help/uht1.…" } ] }
# (a bare array of the same objects is read too). https only; a github.com
# blob address is rewritten to the raw file, and a Hugging Face file page or
# download address (blob or resolve) to its /raw/ address (no Hugging Face
# token is sent, so that file must be public). UPDATE HOME LIST reads it with a
# plain GET (no credential) and merges every valid entry into your home list:
# it never removes anyone, a bad entry is skipped alone, and a known token
# under a new host is flagged MOVED, not followed (a link you added by hand is
# never switched off; its row says the directory lists another host). PUBLISH
# MY TOKEN writes your own { name, link } entry through the GitHub contents
# API when the write token is set (a fine-grained token limited to that
# repository with Contents read and write), otherwise it copies the entry for
# you to send. What is published is location only: anyone who can read the
# directory sees where the phones in it are while their owners ask for help,
# and nothing more (no page, no message box, no number). Keep it private to
# your group. Saved from the box these apply at once (the dev server restarts).
# Until that save, a value typed here by hand is used after npm run dev is
# stopped and started again. After a save, a later hand edit of the address
# or the write token is not used until you save it again from the box. The
# token is sent only to api.github.com and never shown.
# ---------------------------------------------------------------------------
# ULTRA_DIRECTORY_URL=https://raw.githubusercontent.com/<group>/<repo>/main/ultra-directory.json
# ULTRA_DIRECTORY_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# SMS RELAY (POWER UP → SMS RELAY, or the Ultra box's TEST SMS). Optional.
# Texts a call for help to your own cell (a friend's SEND HELP) and to your
# PREDEFINED HELP # numbers (your own SEND HELP) without a tap. Costs money per
# message at the provider's rate. Twilio: the three values from
# console.twilio.com (the from-number with + and the country code); or your
# own gateway that takes POST JSON { to, body } with an Authorization: Bearer
# header, over https (or plain http only to a 100.64.x.x Tailscale address,
# never with user:password in it). POWER UP refuses anything else, and a value
# typed here that the relay cannot use reads as not set (its POWER UP row keeps
# REMOVE). Once per call, a ten-minute cooldown per link, 50 a day
# (the last 20 kept for your own SEND HELP's helpers; friends' calls and TEST
# SMS stop at 30), 60 an hour per host (the same 20 kept, so the others stop at
# 40). Never printed; the box says only configured / not configured. Saved
# from POWER UP these apply at once. Until that save, a value typed here by
# hand is used after npm run dev is stopped and started again. After a save,
# a later hand edit of Twilio or the gateway is not used until you save the
# relay again from POWER UP. A gateway saved beside Twilio is part of that
# check even while Twilio is the one sending.
# ---------------------------------------------------------------------------
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+15065550100
# ULTRA_SMS_RELAY_URL=
# ULTRA_SMS_RELAY_TOKEN=

# ---------------------------------------------------------------------------
# Ask panel language models. Each key present draws its own row in the LLM
# panel. Nothing is called until you press Ask or Overview, or until the mic
# is on for that provider. Ask also runs the basemap label lookup (Google
# reverse geocoding when a Maps key is set). POST /api/llm/ask and the mic's
# /api/llm/voice/* routes share GEV_RATELIMIT_OPENAI_PER_MIN with the other
# paid LLM routes.
# ---------------------------------------------------------------------------
# NVIDIA_API_KEY=            # https://build.nvidia.com/
# NVIDIA_MODEL=moonshotai/kimi-k3
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_REASONING_EFFORT=low   # reasoning models only; 'none' omits the field
# XAI_API_KEY=               # https://console.x.ai/       XAI_MODEL (default grok-4.6)
# Social Media Analysis → GROK BOT SWARM runs on its own xAI key, never
# XAI_API_KEY (POWER UP → GROK BOT): seven requests per press with X Search
# or Web Search to https://api.x.ai/v1, billed by xAI. Model grok-4.6 unless
# XAI_SWARM_MODEL names another.
# GROK_BOT_API_KEY=
# XAI_SWARM_MODEL=grok-4.7
# Without GROK_BOT_API_KEY the press hands one task to the Chief of Staff bot
# in the Grok Bot desktop app. With a webhook routine set up for that bot
# (Grok Bot → Chief of Staff → Routines → When a webhook fires), paste its
# Webhook URL and Webhook key in POWER UP → GROK BOT — CHIEF OF STAFF and
# each press POSTs the task there. The URL must be https on cursor.sh or
# cursor.com, path /automations/webhook/<id>; the key goes nowhere else.
# GROK_BOT_WEBHOOK_URL=https://api2.cursor.sh/automations/webhook/...
# GROK_BOT_WEBHOOK_KEY=
# Without a webhook either, the press opens Grok Bot with the task copied to
# paste: the shortcut or Grok Bot.exe named here (a local drive, .lnk or
# .exe; single quotes keep a Windows path as typed), else Grok Bot's own
# grokbot:// link. A hand edit needs a full restart of npm run dev.
# GROK_BOT_LINK='C:\Users\you\Desktop\Grok Bot.lnk'
# ANTHROPIC_API_KEY=         # https://console.anthropic.com/  ANTHROPIC_MODEL (default claude-fable-5-1)
# OPENROUTER_API_KEY=        # https://openrouter.ai/keys  OPENROUTER_MODEL (default nvidia/nemotron-3-ultra-550b-a55b:free, "NVIDIA: Nemotron 3 Ultra (free)")
# Every LLM key has a MODEL box under POWER UP: NVIDIA_MODEL, XAI_MODEL,
# ANTHROPIC_MODEL, OPENROUTER_MODEL (any id the provider lists; OpenRouter's
# box suggests its free Nemotron models). Left empty, each provider's default
# in server/providers/llm/ask.js is used.
# Any other OpenAI-compatible endpoint, including one running locally.
# All three are required together:
# CUSTOM_LLM_API_KEY=
# CUSTOM_LLM_BASE_URL=       # e.g. http://localhost:11434/v1
# CUSTOM_LLM_MODEL=
# Shared: LLM_MAX_TOKENS (default 2048), LLM_ASK_TIMEOUT_MS (default 240000).
# Both are read per request, so a .env edit takes effect on the next Ask.
# Voice for those five providers. Nothing is called until the mic is on.
# Grok voice is a separate model from XAI_MODEL (the Ask chat model).
# XAI_VOICE_MODEL=grok-voice-latest
# XAI_VOICE=eve
# XAI_VOICE_REASONING=none   # 'high' enables Grok voice reasoning
# OPENROUTER_STT_MODEL=openai/whisper-large-v3
# OPENROUTER_TTS_MODEL=openai/gpt-4o-mini-tts-2025-12-15
# OPENROUTER_TTS_VOICE=alloy
# OPENROUTER_STT_LANGUAGE=en   # 'auto' or blank omits the language
# CUSTOM_LLM_STT_MODEL=whisper-1
# CUSTOM_LLM_TTS_MODEL=tts-1
# CUSTOM_LLM_TTS_VOICE=alloy
# LLM_VOICE_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# CCTV country gate
# ---------------------------------------------------------------------------
# Comma-separated ISO codes of the camera countries to serve. A country that is
# off is never fetched. Enabling US turns the Austin open-data pack on and
# enabling GB turns TfL on (each still downloads only when its area is
# selected); Caltrans also needs CCTV_CALTRANS_DISTRICTS. '*' (the default)
# serves every country, the whole international pack included; an empty value
# serves only entries that declare no country. An entry that declares no
# country is always served, whatever the list says.
#
# To keep the international cameras, leave this unset or use '*'. To narrow it,
# name only the countries you want, for example:
# CCTV_COUNTRIES=CA,US,DE,FR,IT,JP
# Countries in the international pack (ISO 3166-1 alpha-2 codes; XK is Kosovo):
#   AD,AE,AG,AI,AL,AM,AQ,AR,AT,AU,AW,AZ,BA,BB,BE,BG,BH,BJ,BM,BO,BQ,BR,BS,
#   BW,BY,BZ,CH,CK,CL,CN,CO,CR,CU,CV,CY,CZ,DE,DK,DO,DZ,EC,EE,EG,ES,ET,FI,
#   FJ,FK,FO,FR,GB,GD,GE,GG,GH,GI,GL,GP,GR,GS,GT,HK,HN,HR,HU,ID,IE,IL,IM,
#   IN,IR,IS,IT,JE,JM,JO,JP,KE,KG,KH,KR,KW,KY,KZ,LA,LB,LI,LK,LS,LT,LU,LV,
#   MA,MC,MD,ME,MF,MG,MK,MN,MQ,MT,MU,MV,MX,MY,MZ,NA,NC,NF,NG,NI,NL,NO,NP,NZ,
#   OM,PA,PE,PF,PG,PH,PK,PL,PR,PS,PT,PY,QA,RE,RO,RS,RU,SA,SC,SE,SG,SI,SJ,
#   SK,SM,SN,SO,SV,SX,TC,TH,TN,TR,TT,TW,TZ,UG,UY,UZ,VA,VC,VE,VG,VI,VN,VU,XK,
#   ZA,ZM,ZW
# CCTV_COUNTRIES=*

# Optional: comma-separated Overpass URLs; use only instances you run or pay for.
OVERPASS_UPSTREAMS=

# Optional: who may frame the app in embed mode (?embed=1), as CSP
# frame-ancestors sources such as "https://example.com", or * for any page.
# Unset, no page may frame it. Other pages of the app can never be framed.
# GEV_EMBED_FRAME_ANCESTORS=
